{
  "name": "acs-quickstarter-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "node ../tools/node_modules/azure-functions-core-tools/lib/main.js start --port 7071",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@azure/communication-identity": "2.0.0",
    "@azure/cosmos": "4.10.1",
    "@azure/functions": "4.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
